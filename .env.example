# Krishika AI — AWS EC2 Deployment Environment Variables
# Copy this file: cp .env.example .env
# Then fill in your real values. NEVER commit .env to Git.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Krishika AI — CSE494
APP_VERSION=1.0.0
# Set DEBUG=False in production. Never set True on EC2.
DEBUG=False
# Uvicorn port. Must match Nginx proxy_pass and systemd service.
PORT=8001

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure key (run once, then paste here):
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Use your full MongoDB Atlas connection string (SRV format recommended).
# Replace <username>, <password>, <cluster-host>, and <dbname> with your values.
# The cluster must whitelist your EC2 instance's public IP in Atlas Network Access.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<dbname>?retryWrites=true&w=majority&appName=Krishika
MONGO_DB_NAME=krishika_cse494

# ── Image Storage ────────────────────────────────────────────────────────────
# Absolute path is recommended for production. Must be writable by the app user.
# Example: /home/ubuntu/krishika-uploads
# Relative path ("uploads") works if you always start uvicorn from the project root.
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10.0

# ── ML ───────────────────────────────────────────────────────────────────────
# Set True so VGG19 is loaded at startup (not at first request).
WARMUP_ON_START=True
CONFIDENCE_THRESHOLD=0.60

# ── CORS ─────────────────────────────────────────────────────────────────────
# JSON array of allowed frontend origins. Must include your Vercel deployment URL.
# To add multiple origins: ["https://app.vercel.app","http://localhost:3000"]
CORS_ORIGINS=["https://krishika-ai-crop-disease-detection-brown.vercel.app"]
