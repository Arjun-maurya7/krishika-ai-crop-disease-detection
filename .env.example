# Krishika AI — CSE494 MongoDB Project
# Copy this file to .env and fill in your values

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=Krishika AI — CSE494
DEBUG=False

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_32_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017
# NOTE: Uses a SEPARATE database from the original Krishika AI project
# Original project uses krishika_ai; this uses krishika_cse494
MONGO_DB_NAME=krishika_cse494

# ── Image Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE_MB=10.0

# ── ML ───────────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.60
WARMUP_ON_START=True

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
